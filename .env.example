# Your Gmail address (the newsletter is sent from and to this address)
GMAIL_USER=your.name@gmail.com

# A 16-character Gmail App Password (NOT your normal Gmail password)
# Create one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Optional: send to a different address (defaults to GMAIL_USER)
NEWSLETTER_TO=

# Optional: port for the web page (defaults to 3000)
PORT=3000
